# Copy to .env.local (gitignored) to point the creator at a real bucket.
# Leave it unset and everything works against localStorage instead.
#
# The endpoint must implement:
#   GET <endpoint>?op=<get|put|delete>&key=<url-encoded-key>
#   200 -> { "url": "<presigned-https-url>" }
#
# It is responsible for authorising the caller and for rejecting keys outside
# the prefix in config.persistence.prefix. No credential is held on the
# client, so anything the endpoint permits is permitted to the whole internet.
VITE_PRESIGN_ENDPOINT=

# For the deployed site this is set as a GitHub Actions repository *variable*
# of the same name (Settings -> Secrets and variables -> Actions -> Variables),
# read by .github/workflows/deploy.yml. Vite inlines it into the bundle, so it
# is public either way -- a secret would only hide it from the Actions log.
#
# You can also override it per-visit without rebuilding:
#   /creator?persistence.presignEndpoint=https://...

# --- Firebase Realtime Database: the state of a round in progress ----------
#
# Copy these from Firebase console -> Project settings -> Your apps -> Config.
# None of them is a secret: a web config identifies the project, it does not
# authorise anything. What protects a live round is the database rules plus
# the document's liveKey, which never appears in a published share link.
#
# Leave them unset and the live screens fall back to a same-browser transport,
# which is enough to rehearse both screens on one machine.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
